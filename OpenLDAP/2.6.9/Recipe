compile_version=017-GIT
# Recipe for OpenLdap by Maglan C. Diemer, maglan@univates.br
url="https://www.openldap.org/software/download/OpenLDAP/openldap-release/openldap-2.6.9.tgz"
file_size=6516669
file_md5=608973c35cd4924fca0f07d0ea72c016
recipe_type=configure
configure_options=(
   --libexecdir=$target/lib
   --localstatedir="${goboVariable}/lib/openldap"
   --with-cyrus-sasl=no
   --with-tls=no
#   --enable-slapd=no

   --sysconfdir=$goboSettings
   --disable-static
   --enable-dynamic
   --disable-debug
   --disable-slapd
)
with_cyrus_sasl="--with-cyrus-sasl=yes"
with_openssl="--with-tls=openssl"

make_variables=(
   LIBTOOL="${goboExecutables}/libtool --tag=CC"
)

pre_install() {
   mkdir -p "${goboVariable}/lib/openldap"
}

sandbox_options=(
    "--allow-leftovers"
)
unmanaged_files=(
    "${goboVariable}/lib/openldap"
)
