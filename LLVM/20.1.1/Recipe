pre_build() {
    echo "Testing every tool before compilation to avoid issues later..."
    for tool in {CC,CXX,LD,ADDR2LINE,AR,AS,NM,OBJCOPY,OBJDUMP,RANLIB,READELF,STRINGS,STRIP}
    do
      if [ "$(command -v $(eval echo \$$tool))" == "" ]
      then
        $(eval echo \$$tool)
	exit -1
      fi
    done
    echo "All tools functional!"

    # -Wconstant-logical-operand in .inc
    w_no_clo="-Wno-constant-logical-operand"
    export CC="$CC $w_no_clo"
    export CXX="$CXX $w_no_clo"
    export CFLAGS="$CFLAGS $w_no_clo"
    export CXXFLAGS="$CXXFLAGS $w_no_clo"
    # cache dir
    CCACHE_DIR="$CCACHE_DIR/../LLVM/20.1.1/"
    BUILDCACHE_DIR="$BUILDCACHE_DIR/../LLVM/20.1.1/"
    ###
    [ -e .lazy ]&& echo Lazy, are we? ; return 0
    cd ..
    # llvm
    sed '/LLVM_COMMON_CMAKE_UTILS/s@../cmake@..\/cmake-20.1.1.src@' \
        -i CMakeLists.txt
    sed '/LLVM_THIRD_PARTY_DIR/s@../third-party@..\/third-party-20.1.1.src@' \
        -i cmake/modules/HandleLLVMOptions.cmake

    # script fix
    grep -rl '#!.*python' | xargs sed -i '1s/python$/python3/' || echo "Everything is already python3"

    # clang
    mv ../clang-20.1.1.src tools/clang

    # compiler-rt
    mv ../compiler-rt-20.1.1.src runtimes/compiler-rt

    # tests
    sed 's/utility/tool/' -i utils/FileCheck/CMakeLists.txt
    #with compiler-rt?
    sed -e 's/config.has_no_default_config_flag/True/' \
        -i projects/compiler-rt/test/lit.common.cfg.py
    ###
    cd _build
    touch .lazy
}
