cmake_options=(
    # cmake
    ${CC_VARS[*]}
    -D CMAKE_INSTALL_PREFIX=$goboIndex
    -D CMAKE_SKIP_INSTALL_RPATH=ON
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_MAKE_PROGRAM=$ninja
    
    # sphinx
#    -D SPHINX_WARNINGS_AS_ERRORS=OFF

    # includes
    -D FFI_INCLUDE_DIR=$(pkg-config --variable=includedir libffi)

    # llvm
    -D LLVM_ENABLE_FFI=OFF
    -D LLVM_BUILD_LLVM_DYLIB=ON
    -D LLVM_LINK_LLVM_DYLIB=ON
    -D LLVM_ENABLE_RTTI=ON
    -D LLVM_TARGETS_TO_BUILD="host;AMDGPU;BPF"
    -D LLVM_BINUTILS_INCDIR=$goboIndex/include
    -D LLVM_INCLUDE_BENCHMARKS=OFF
    -D LLVM_INSTALL_UTILS=ON
    -D LLVM_INCLUDE_TESTS=OFF
    -D LLVM_BUILD_DOCS=OFF
    -D LLVM_ENABLE_DOXYGEN=OFF

    -D LLVM_ENABLE_PROJECTS="$(IFS=';'; echo "${llvm_projects[*]}")"
    -D LLVM_ENABLE_RUNTIMES="$(IFS=';'; echo "${llvm_runtimes[*]}")"
    #TODO: make that use-controlled

    # clang
#    -D CLANG_DEFAULT_PIE_ON_LINUX=ON
#    -D CLANG_CONFIG_FILE_SYSTEM_DIR=$goboSettings/clang

    # lld
    -D LLVM_USE_LINKER=lld

    # globals
    -G Ninja
    -D Python3_EXECUTABLE=$goboExecutables/python3

    # warns
    -Wno-dev
    -Wno-gnu-line-marker
    -Wno-unused-command-line-argument
    -Wno-constant-logical-operand
    -Wno-parentheses-equality
    -Wno-unused-variable
    -Wno-tautological-compare
)
using_libffi() { cmake_options+=(-D LLVM_ENABLE_FFI=ON); }

cmake_do_configuration() {
  cmake -S ../llvm ${cmake_options[*]}
}
cmake_do_build() {
  $ninja || wrap_fail "Build failed."
}
pre_install() {
    # tests
    sh -c 'ulimit -c 0 && ninja check-all'

    mkdir -pv /etc/clang &&
    for i in clang clang++; do
        echo -fstack-protector-strong > /etc/clang/$i.cfg
    done
}
cmake_do_install() {
  SandboxInstall $verbose ${unmanagedlist:+--unmanaged-files "${unmanagedlist}"} ${sandboxopts:+"${sandboxopts[@]}"} -c "$ninja install" "$appname" "$versionnumber" -- "${ninja_variables[@]}" "${install_variables[@]}" $install_target || wrap_fail "Installation failed"
}
